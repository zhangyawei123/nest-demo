# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nest_demo

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 应用配置
PORT=3000
PUBLIC_BASE_URL=http://your-domain.com

# AI 对话配置
AI_BASE_URL=https://fluxcoding.online/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-4.1
DRAW_BASE_URL=https://www.right.codes
DRAW_API_PATH=/draw/v1/images/generations
DRAW_API_KEY=your-draw-api-key
DRAW_MODEL=gpt-image-2
