# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nest_demo

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 应用配置
PORT=3000
PUBLIC_BASE_URL=https://your-domain.com

# AI 对话配置
AI_BASE_URL=https://fluxcoding.online/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-4.1
DRAW_BASE_URL=https://tupian.kklt.lol
DRAW_GENERATION_API_PATH=/api/draw/generations
DRAW_EDIT_API_PATH=/api/draw/edits
DRAW_ME_API_PATH=/api/draw/me
DRAW_HISTORY_API_PATH=/api/draw/history
DRAW_API_KEY=your-draw-api-key
DRAW_MODEL=draw-image

# 京东商品趋势监控
# Cookie 仅保存在服务器 .env，不会返回前端或写入数据库。
JD_COOKIE=
JD_COOKIE_FILE=.jd_cookie.txt
JD_CHROME_EXECUTABLE=/usr/bin/chromium
JD_TREND_INTERVAL_HOURS=6
JD_TREND_REPORT_HOUR=18
JD_TREND_DELAY_SECONDS=12
JD_TREND_JITTER_SECONDS=18
JD_TREND_TIMEOUT_MS=45000
JD_TREND_RISK_COOLDOWN_HOURS=24
JD_TREND_NOTIFY_REPORT=true


# 企业微信群机器人 Webhook（个人微信不支持官方机器人 Webhook）。
WECOM_WEBHOOK_URL=
