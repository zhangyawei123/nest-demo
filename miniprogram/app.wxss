/* 全局样式 */
page {
  background: linear-gradient(180deg, #f2f6ff 0%, #f7f9fc 35%, #ffffff 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #24324a;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(20, 44, 88, 0.08);
  box-sizing: border-box;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4c8dff 0%, #63b3ff 100%);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  padding: 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(76, 141, 255, 0.22);
}

.btn-primary::after {
  border: none;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #97a2b5;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #97a2b5;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.tag-blue {
  background: rgba(76, 141, 255, 0.12);
  color: #3d7fff;
}

.tag-green {
  background: rgba(52, 199, 89, 0.12);
  color: #28a745;
}

.tag-orange {
  background: rgba(255, 177, 66, 0.16);
  color: #e67e22;
}

.tag-red {
  background: rgba(245, 108, 108, 0.14);
  color: #f56c6c;
}
