page { background: #1a237e; }
.decibel-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx; }
.db-display { display: flex; align-items: baseline; gap: 8rpx; }
.db-value { font-size: 120rpx; color: #fff; font-weight: 700; font-family: monospace; }
.db-unit { font-size: 36rpx; color: rgba(255,255,255,0.6); }
.db-bar-wrap { width: 600rpx; height: 24rpx; background: rgba(255,255,255,0.1); border-radius: 12rpx; margin-top: 40rpx; overflow: hidden; }
.db-bar { height: 100%; border-radius: 12rpx; background: linear-gradient(to right, #66bb6a, #fdd835, #ff7043, #ef5350); transition: width 0.15s; }
.db-level { margin-top: 24rpx; }
.db-level-text { font-size: 32rpx; font-weight: 600; }
.lv-green { color: #66bb6a; }
.lv-yellow { color: #fdd835; }
.lv-orange { color: #ff7043; }
.lv-red { color: #ef5350; }
.db-legend { display: flex; flex-wrap: wrap; gap: 24rpx; margin-top: 48rpx; }
.db-legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: rgba(255,255,255,0.6); }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.legend-green { background: #66bb6a; }
.legend-yellow { background: #fdd835; }
.legend-orange { background: #ff7043; }
.legend-red { background: #ef5350; }
.db-btn { margin-top: 60rpx; padding: 20rpx 80rpx; background: rgba(255,255,255,0.15); border-radius: 40rpx; }
.db-btn text { font-size: 30rpx; color: #fff; font-weight: 600; }
