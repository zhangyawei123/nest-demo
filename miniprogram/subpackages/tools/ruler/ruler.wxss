page { background: #1b5e20; }
.ruler-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 20rpx; }
.ruler-canvas { width: 200rpx; height: 85vh; border-radius: 12rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3); }
.ruler-reading { margin-top: 24rpx; display: flex; flex-direction: column; align-items: center; }
.ruler-value { font-size: 48rpx; color: #fff; font-weight: 700; font-family: monospace; }
.ruler-tip { font-size: 22rpx; color: rgba(255,255,255,0.6); margin-top: 8rpx; }
.ruler-slider { width: 600rpx; margin-top: 20rpx; }
