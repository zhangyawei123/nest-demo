page { background: #880e4f; }
.mirror-page { min-height: 100vh; display: flex; flex-direction: column; }
.mirror-camera { width: 100%; flex: 1; }
.mirror-controls { display: flex; justify-content: center; gap: 24rpx; padding: 24rpx 30rpx 60rpx; background: rgba(0,0,0,0.3); }
.mirror-btn { padding: 16rpx 32rpx; border-radius: 32rpx; background: rgba(255,255,255,0.12); }
.mirror-btn.active { background: rgba(255,255,255,0.3); }
.mirror-btn text { font-size: 26rpx; color: #fff; }
