page { background: #212121; }
.calc-page { min-height: 100vh; display: flex; flex-direction: column; }
.calc-display { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding: 40rpx 40rpx 30rpx; }
.calc-expr { font-size: 28rpx; color: rgba(255,255,255,0.45); text-align: right; min-height: 40rpx; }
.calc-result { font-size: 80rpx; color: #fff; font-weight: 300; text-align: right; word-break: break-all; font-family: monospace; }
.calc-keys { padding: 10rpx 16rpx 40rpx; }
.calc-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.calc-key { flex: 1; height: 120rpx; border-radius: 60rpx; background: #333; display: flex; align-items: center; justify-content: center; }
.calc-key:active { opacity: 0.7; }
.calc-key text { font-size: 40rpx; color: #fff; }
.key-func { background: #a5a5a5; }
.key-func text { color: #000; }
.key-op { background: #ff9500; }
.key-op text { color: #fff; font-weight: 600; }
.key-zero { flex: 2; }
