page {
  background: linear-gradient(180deg, #6a4bd9 0%, #4838a0 50%, #3a2d80 100%);
}

.clean-page {
  min-height: 100vh;
  padding: 30rpx;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.45;
  pointer-events: none;
}

.orb-a {
  width: 440rpx;
  height: 440rpx;
  background: #a07cff;
  top: -160rpx;
  right: -100rpx;
}

.orb-b {
  width: 360rpx;
  height: 360rpx;
  background: #5e3ec0;
  bottom: 200rpx;
  left: -140rpx;
}

.section {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 28rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 28rpx;
  backdrop-filter: blur(20rpx);
}

/* ---- 操作区 ---- */
.operate-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.speaker-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.main-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.main-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.safe-badge {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  background: rgba(76, 175, 80, 0.25);
  border-radius: 30rpx;
}

.safe-icon {
  font-size: 28rpx;
}

.safe-text {
  font-size: 22rpx;
  color: #a5d6a7;
}

/* ---- 频率选择 ---- */
.freq-card {
  width: 100%;
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 28rpx;
}

.freq-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.freq-header-icon {
  font-size: 32rpx;
}

.freq-header-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.freq-list {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.freq-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  transition: all 0.25s;
}

.freq-item.freq-active {
  background: rgba(255, 255, 255, 0.18);
  box-shadow: 0 0 20rpx rgba(160, 124, 255, 0.4);
}

.freq-gem {
  font-size: 48rpx;
}

.freq-gem-low {
  color: #ffa726;
}

.freq-gem-mid {
  color: #42a5f5;
}

.freq-gem-high {
  color: #26c6da;
}

.freq-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

/* ---- 播放按钮 ---- */
.play-btn-wrap {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.play-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #7e57c2, #5c35a6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(126, 87, 194, 0.6),
    inset 0 -4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s;
}

.play-btn:active {
  transform: scale(0.93);
}

.play-btn.playing {
  background: linear-gradient(145deg, #e57373, #d32f2f);
  box-shadow: 0 8rpx 40rpx rgba(211, 47, 47, 0.6),
    inset 0 -4rpx 12rpx rgba(0, 0, 0, 0.2);
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.play-icon {
  font-size: 72rpx;
}

.play-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

/* ---- 进度条 ---- */
.progress-wrap {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.progress-wrap progress {
  width: 80%;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ---- 底部标签 ---- */
.tag-bar {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 36rpx;
  width: 100%;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
}

.tag-emoji {
  font-size: 28rpx;
}

.tag-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---- 说明区 ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 24rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.guide-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
}

.guide-num {
  min-width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a07cff, #7c4dff);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ---- 效果对比 ---- */
.effect-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.effect-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 30rpx 10rpx;
  border-radius: 20rpx;
}

.effect-before {
  background: rgba(255, 183, 77, 0.2);
}

.effect-after {
  background: rgba(129, 199, 132, 0.2);
}

.effect-emoji {
  font-size: 56rpx;
}

.effect-label {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.effect-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.effect-arrow {
  font-size: 40rpx;
}