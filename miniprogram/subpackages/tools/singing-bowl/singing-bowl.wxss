page { background: linear-gradient(180deg, #455a64 0%, #263238 100%); }
.bowl-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 60rpx 30rpx; }
.bowl-header { display: flex; flex-direction: column; align-items: center; }
.bowl-title { font-size: 44rpx; color: #fff; font-weight: 700; }
.bowl-desc { margin-top: 12rpx; font-size: 24rpx; color: rgba(255,255,255,0.65); }
.bowl-zone { margin-top: 120rpx; width: 420rpx; height: 420rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.sound-ring { position: absolute; border-radius: 50%; border: 2rpx solid rgba(255,255,255,0.16); opacity: 0; }
.ring-1 { width: 220rpx; height: 220rpx; }
.ring-2 { width: 300rpx; height: 300rpx; }
.ring-3 { width: 380rpx; height: 380rpx; }
.ring-active { animation: ringPulse 1.2s ease-out; }
@keyframes ringPulse { 0% { opacity: 0.7; transform: scale(0.8); } 100% { opacity: 0; transform: scale(1.2); } }
.bowl-body { width: 220rpx; height: 220rpx; border-radius: 50%; background: radial-gradient(circle at 50% 35%, #ffecb3, #bfa36b 72%); display: flex; align-items: center; justify-content: center; box-shadow: 0 16rpx 36rpx rgba(0,0,0,0.25); transition: transform 0.2s; }
.bowl-active { transform: scale(0.95); }
.bowl-emoji { font-size: 96rpx; }
.bowl-tip { margin-top: 70rpx; font-size: 28rpx; color: rgba(255,255,255,0.82); }
.bowl-actions { margin-top: 80rpx; }
.bowl-btn { padding: 18rpx 50rpx; background: rgba(255,255,255,0.12); border-radius: 36rpx; }
.bowl-btn-active { background: rgba(255,255,255,0.24); box-shadow: 0 0 28rpx rgba(255,255,255,0.16); }
.bowl-btn text { color: #fff; font-size: 28rpx; }
