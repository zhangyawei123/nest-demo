page { background: #0d1b2a; }
.compass-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.compass-degree { display: flex; flex-direction: column; align-items: center; margin-bottom: 40rpx; }
.degree-text { font-size: 72rpx; color: #fff; font-weight: 700; font-family: monospace; }
.direction-text { font-size: 36rpx; color: #4fc3f7; font-weight: 600; margin-top: 8rpx; }
.compass-ring { width: 500rpx; height: 500rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.2); position: relative; display: flex; align-items: center; justify-content: center; transition: transform 0.15s linear; }
.compass-n, .compass-e, .compass-s, .compass-w { position: absolute; font-size: 36rpx; font-weight: 700; color: rgba(255,255,255,0.7); }
.compass-n { top: 20rpx; left: 50%; transform: translateX(-50%); color: #ef5350; }
.compass-s { bottom: 20rpx; left: 50%; transform: translateX(-50%); }
.compass-e { right: 20rpx; top: 50%; transform: translateY(-50%); }
.compass-w { left: 20rpx; top: 50%; transform: translateY(-50%); }
.compass-needle { width: 6rpx; height: 200rpx; background: linear-gradient(to bottom, #ef5350 50%, #fff 50%); border-radius: 3rpx; position: absolute; }
.compass-tip { margin-top: 50rpx; font-size: 22rpx; color: rgba(255,255,255,0.4); }
