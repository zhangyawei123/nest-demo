page { background: #263238; }
.qr-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 40rpx; }
.qr-input-wrap { width: 100%; background: rgba(255,255,255,0.08); border-radius: 16rpx; padding: 24rpx; }
.qr-input { width: 100%; height: 160rpx; font-size: 28rpx; color: #fff; background: transparent; }
.qr-canvas-wrap { margin-top: 40rpx; padding: 30rpx; background: #fff; border-radius: 20rpx; }
.qr-canvas { width: 300px; height: 300px; }
.qr-empty { margin-top: 80rpx; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.qr-empty-icon { font-size: 80rpx; }
.qr-empty-text { font-size: 26rpx; color: rgba(255,255,255,0.4); }
.qr-btn { margin-top: 40rpx; padding: 20rpx 80rpx; background: rgba(255,255,255,0.15); border-radius: 40rpx; }
.qr-btn text { font-size: 30rpx; color: #fff; font-weight: 600; }
