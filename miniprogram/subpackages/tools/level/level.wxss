page { background: #0d1b2a; }
.level-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.level-ring { width: 500rpx; height: 500rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.25); position: relative; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.04); }
.level-crosshair-h { position: absolute; width: 100%; height: 2rpx; background: rgba(255,255,255,0.15); }
.level-crosshair-v { position: absolute; width: 2rpx; height: 100%; background: rgba(255,255,255,0.15); }
.level-bubble { width: 60rpx; height: 60rpx; border-radius: 50%; background: #4fc3f7; box-shadow: 0 0 30rpx rgba(79,195,247,0.6); transition: transform 0.1s linear; position: absolute; }
.level-info { margin-top: 60rpx; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.level-value { font-size: 28rpx; color: rgba(255,255,255,0.7); font-family: monospace; }
.level-status { font-size: 32rpx; color: #ef5350; font-weight: 600; }
.level-status.level-ok { color: #66bb6a; }
