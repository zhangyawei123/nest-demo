.articles-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  background: linear-gradient(180deg, #f2f6ff 0%, #f7f9fc 42%, #ffffff 100%);
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.52;
  pointer-events: none;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  right: -50rpx;
  top: 20rpx;
  background: radial-gradient(circle, rgba(103, 175, 255, 0.34) 0%, rgba(103, 175, 255, 0) 72%);
}

.orb-2 {
  width: 300rpx;
  height: 300rpx;
  left: -110rpx;
  top: 260rpx;
  background: radial-gradient(circle, rgba(245, 108, 108, 0.18) 0%, rgba(245, 108, 108, 0) 76%);
}

.hero-card {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(75, 127, 255, 0.98) 0%, rgba(99, 179, 255, 0.9) 56%, rgba(155, 219, 255, 0.82) 100%);
  box-shadow: 0 18rpx 44rpx rgba(75, 127, 255, 0.18);
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  right: -60rpx;
  top: -70rpx;
  background: rgba(255,255,255,0.12);
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255,255,255,0.72);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.88);
  position: relative;
  z-index: 1;
}

.search-bar {
  position: relative;
  z-index: 1;
}

.search-label {
  display: block;
  font-size: 24rpx;
  color: #6f7d92;
  margin-bottom: 16rpx;
}

.search-input {
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  border-radius: 999rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  box-shadow: inset 0 0 0 1rpx #edf2fa;
}

.article-list {
  position: relative;
  z-index: 1;
}

.article-card {
  display: flex;
  gap: 22rpx;
  padding: 26rpx;
}

.article-cover {
  flex-shrink: 0;
}

.cover-img {
  width: 186rpx;
  height: 132rpx;
  border-radius: 20rpx;
  background: #eef2f8;
}

.article-info {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

.article-badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(76, 141, 255, 0.12);
  color: #4c8dff;
  font-size: 20rpx;
  font-weight: 600;
}

.article-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #25324a;
  display: block;
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-top: 14rpx;
}

.article-summary {
  font-size: 24rpx;
  color: #8c96a8;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 10rpx;
  line-height: 1.6;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #a0abbd;
  margin-top: 16rpx;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #97a2b5;
  font-size: 26rpx;
}
