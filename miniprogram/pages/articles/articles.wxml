<view class="articles-page">
  <view class="bg-orb orb-1"></view>
  <view class="bg-orb orb-2"></view>

  <view class="hero-card">
    <text class="hero-kicker">CONTENT HUB</text>
    <text class="hero-title">文章中心</text>
    <text class="hero-desc">浏览最新内容、快速搜索感兴趣的话题，沉浸式阅读每一篇文章。</text>
  </view>

  <view class="search-bar card">
    <text class="search-label">搜索文章</text>
    <input class="search-input" placeholder="输入标题、摘要关键词..." value="{{keyword}}" bindinput="onSearch" bindconfirm="doSearch" />
  </view>

  <view class="article-list">
    <view class="article-card card" wx:for="{{articles}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="article-cover" wx:if="{{item.coverImage}}">
        <image src="{{item.coverImage}}" mode="aspectFill" class="cover-img" />
      </view>
      <view class="article-info">
        <text class="article-badge">精选内容</text>
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary || ''}}</text>
        <view class="article-meta">
          <text class="meta-author">{{item.author.username || '匿名'}}</text>
          <text class="meta-time">{{item.createdAtText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !articles.length}}">
    <text class="empty-icon">📄</text>
    <text class="empty-text">暂无文章</text>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
