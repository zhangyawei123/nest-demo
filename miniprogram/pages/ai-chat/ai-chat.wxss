.chat-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.5;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  top: 10rpx;
  right: -70rpx;
  background: radial-gradient(circle, rgba(76, 141, 255, 0.28) 0%, rgba(76, 141, 255, 0) 72%);
}

.orb-2 {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 320rpx;
  background: radial-gradient(circle, rgba(110, 231, 183, 0.18) 0%, rgba(110, 231, 183, 0) 76%);
}

.chat-hero {
  position: relative;
  z-index: 1;
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, rgba(64, 127, 255, 0.98) 0%, rgba(98, 169, 255, 0.92) 56%, rgba(149, 223, 255, 0.86) 100%);
  box-shadow: 0 18rpx 44rpx rgba(75, 127, 255, 0.18);
  overflow: hidden;
}

.chat-hero::after {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  top: -70rpx;
  right: -60rpx;
  background: rgba(255,255,255,0.12);
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255,255,255,0.72);
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.88);
  position: relative;
  z-index: 1;
}

.chat-messages {
  flex: 1;
  width: auto;
  margin: 18rpx 24rpx 0;
  padding: 0 0 20rpx;
  position: relative;
  z-index: 1;
}

.msg-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 140rpx;
  color: #97a2b5;
}

.msg-empty-icon {
  font-size: 92rpx;
  margin-bottom: 20rpx;
}

.msg-empty-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #24324a;
  margin-bottom: 12rpx;
}

.msg-empty-desc {
  width: 520rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.7;
}

.msg-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #eef4ff, #f8fbff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx rgba(76, 141, 255, 0.08);
}

.msg-user .msg-avatar {
  background: linear-gradient(135deg, #4c8dff, #63b3ff);
}

.msg-bubble {
  max-width: 72%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  margin: 0 16rpx;
  word-break: break-all;
}

.msg-user .msg-bubble {
  background: linear-gradient(135deg, #4c8dff, #63b3ff);
  border-radius: 24rpx 24rpx 10rpx 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(76, 141, 255, 0.16);
}

.msg-user .msg-text {
  color: #fff;
}

.msg-assistant .msg-bubble {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 24rpx 24rpx 24rpx 10rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 44, 88, 0.08);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.72;
  color: #24324a;
}

.chat-input-area {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 24rpx;
  padding: 14rpx 16rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.9);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(20, 44, 88, 0.08);
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.chat-input {
  flex: 1;
  background: #f6f8fc;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #dbe3ef;
  color: #fff;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #4c8dff, #63b3ff);
  box-shadow: 0 10rpx 22rpx rgba(76, 141, 255, 0.2);
}
