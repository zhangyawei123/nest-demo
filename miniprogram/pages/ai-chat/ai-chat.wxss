.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

.chat-messages {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 20rpx;
}

.msg-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #909399;
}

.msg-empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.msg-empty-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #303133;
  margin-bottom: 8rpx;
}

.msg-empty-desc {
  font-size: 26rpx;
}

.msg-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e4e7ed;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.msg-user .msg-avatar {
  background: #409eff;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin: 0 16rpx;
  word-break: break-all;
}

.msg-user .msg-bubble {
  background: #409eff;
  border-radius: 16rpx 16rpx 4rpx 16rpx;
}

.msg-user .msg-text {
  color: #fff;
}

.msg-assistant .msg-bubble {
  background: #fff;
  border-radius: 16rpx 16rpx 16rpx 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #303133;
}

.chat-input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e4e7ed;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #dcdfe6;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.send-btn.active {
  background: #409eff;
}
