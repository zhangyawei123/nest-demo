<view class="chat-page">
  <view class="bg-orb orb-1"></view>
  <view class="bg-orb orb-2"></view>

  <view class="chat-hero card">
    <text class="hero-kicker">AI ASSISTANT</text>
    <text class="hero-title">智能对话</text>
    <text class="hero-desc">向 AI 提问、获取灵感、总结内容或即时解答你的问题。</text>
  </view>

  <scroll-view class="chat-messages" scroll-y scroll-into-view="{{scrollToId}}" enhanced show-scrollbar="{{false}}">
    <view class="msg-empty" wx:if="{{!messages.length}}">
      <text class="msg-empty-icon">🤖</text>
      <text class="msg-empty-title">AI 助手</text>
      <text class="msg-empty-desc">试试问我：帮我总结、写文案、解释概念、生成方案</text>
    </view>

    <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="msg-item msg-{{item.role}}">
      <view class="msg-avatar">
        <text wx:if="{{item.role === 'user'}}">👤</text>
        <text wx:else>🤖</text>
      </view>
      <view class="msg-bubble">
        <text class="msg-text">{{item.content}}</text>
      </view>
    </view>

    <view wx:if="{{loading}}" id="msg-loading" class="msg-item msg-assistant">
      <view class="msg-avatar"><text>🤖</text></view>
      <view class="msg-bubble">
        <text class="msg-text">{{streamContent || '思考中...'}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="chat-input-area">
    <input class="chat-input" placeholder="输入你的问题，按发送开始对话" value="{{inputText}}" bindinput="onInput" bindconfirm="sendMsg" confirm-type="send" />
    <view class="send-btn {{inputText ? 'active' : ''}}" bindtap="sendMsg">
      <text>发送</text>
    </view>
  </view>
</view>
