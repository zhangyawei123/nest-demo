.notice-page {
  padding: 24rpx;
}

.notice-card {
  margin-bottom: 20rpx;
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #c0c4cc;
}

.notice-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #303133;
  display: block;
  margin-bottom: 12rpx;
}

.notice-content {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
}
