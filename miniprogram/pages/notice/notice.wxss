.notice-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  background: linear-gradient(180deg, #f2f6ff 0%, #f7f9fc 42%, #ffffff 100%);
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.5;
  pointer-events: none;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  top: 10rpx;
  right: -60rpx;
  background: radial-gradient(circle, rgba(76, 141, 255, 0.26) 0%, rgba(76, 141, 255, 0) 72%);
}

.orb-2 {
  width: 300rpx;
  height: 300rpx;
  top: 260rpx;
  left: -110rpx;
  background: radial-gradient(circle, rgba(245, 108, 108, 0.14) 0%, rgba(245, 108, 108, 0) 76%);
}

.hero-card {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(72, 118, 255, 0.98) 0%, rgba(110, 163, 255, 0.92) 55%, rgba(158, 220, 255, 0.84) 100%);
  box-shadow: 0 18rpx 44rpx rgba(76, 141, 255, 0.18);
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  right: -60rpx;
  top: -70rpx;
  background: rgba(255,255,255,0.12);
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255,255,255,0.72);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.88);
  position: relative;
  z-index: 1;
}

.notice-list {
  position: relative;
  z-index: 1;
}

.notice-card {
  margin-bottom: 20rpx;
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #a0abbd;
}

.notice-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #25324a;
  display: block;
  margin-bottom: 14rpx;
  line-height: 1.45;
}

.notice-content {
  font-size: 26rpx;
  color: #66768d;
  line-height: 1.7;
}
