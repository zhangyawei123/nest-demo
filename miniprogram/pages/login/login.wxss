/* ========= 整体布局 ========= */
.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #1a73e8 0%, #4a9af5 35%, #7ec4ff 70%, #e8f4fd 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  position: relative;
}

/* ========= 背景装饰圆 ========= */
.bg-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 600rpx;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.12;
}

.c1 {
  width: 400rpx;
  height: 400rpx;
  background: #fff;
  top: -120rpx;
  right: -80rpx;
}

.c2 {
  width: 240rpx;
  height: 240rpx;
  background: #fff;
  top: 80rpx;
  left: -60rpx;
}

.c3 {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  top: 280rpx;
  right: 100rpx;
}

/* ========= Logo 区域 ========= */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
  padding-bottom: 48rpx;
  position: relative;
  z-index: 1;
}

.logo-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.25);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.logo-emoji {
  font-size: 64rpx;
}

.logo-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.logo-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ========= 表单卡片 ========= */
.form-card {
  width: 85%;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(26,115,232,0.15), 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: relative;
  z-index: 1;
}

.input-group {
  margin-bottom: 12rpx;
}

/* ========= 输入框 ========= */
.input-wrap {
  display: flex;
  align-items: center;
  background: #f4f6f9;
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input-wrap:focus-within {
  border-color: #409eff;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(64,158,255,0.1);
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #303133;
  height: 96rpx;
}

.placeholder {
  color: #c0c4cc;
  font-size: 28rpx;
}

/* ========= 验证码 ========= */
.captcha-wrap {
  padding-right: 12rpx;
}

.captcha-field {
  flex: 1;
}

.captcha-box {
  width: 200rpx;
  height: 72rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  border: 2rpx solid #e4e7ed;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f6f9;
}

.captcha-img {
  width: 100%;
  height: 100%;
}

.captcha-placeholder {
  font-size: 24rpx;
  color: #409eff;
}

/* ========= 登录按钮 ========= */
.login-btn {
  width: 100%;
  height: 96rpx;
  border: none;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1a73e8, #4a9af5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(26,115,232,0.35);
  padding: 0;
}

.login-btn::after {
  border: none;
}

.login-btn-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

/* ========= 底部链接 ========= */
.bottom-row {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
}

.register-link {
  font-size: 26rpx;
  color: #909399;
}

.link-highlight {
  color: #1a73e8;
  font-weight: 600;
  margin-left: 4rpx;
}

/* ========= 页脚 ========= */
.footer-text {
  position: fixed;
  bottom: 48rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  z-index: 0;
}
