.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #409eff 0%, #66b1ff 40%, #f5f7fa 40%);
  padding: 0 48rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  padding-bottom: 60rpx;
}

.logo-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.logo-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.form-area {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: #606266;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  border: 2rpx solid #dcdfe6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.captcha-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.captcha-input {
  flex: 1;
}

.captcha-img {
  width: 200rpx;
  height: 80rpx;
  border-radius: 8rpx;
  border: 2rpx solid #dcdfe6;
}

.login-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
}

.register-link {
  text-align: center;
  margin-top: 32rpx;
  color: #409eff;
  font-size: 26rpx;
}
