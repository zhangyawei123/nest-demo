<view class="login-page">
  <!-- 顶部背景装饰 -->
  <view class="bg-top">
    <view class="bg-circle c1"></view>
    <view class="bg-circle c2"></view>
    <view class="bg-circle c3"></view>
  </view>

  <!-- Logo 区域 -->
  <view class="logo-area">
    <view class="logo-box">
      <text class="logo-emoji">🚀</text>
    </view>
    <text class="logo-title">NestDemo</text>
    <text class="logo-subtitle">全栈演示平台 · 小程序端</text>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card">
    <view class="input-group">
      <view class="input-wrap">
        <text class="input-icon">👤</text>
        <input class="input-field" placeholder="请输入用户名" placeholder-class="placeholder" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="input-wrap">
        <text class="input-icon">🔒</text>
        <input class="input-field" placeholder="请输入密码" placeholder-class="placeholder" password="true" value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <view class="input-wrap captcha-wrap">
        <text class="input-icon">🛡️</text>
        <input class="input-field captcha-field" placeholder="验证码" placeholder-class="placeholder" value="{{captcha}}" bindinput="onCaptchaInput" />
        <view class="captcha-box" bindtap="refreshCaptcha">
          <image wx:if="{{captchaImg}}" class="captcha-img" src="{{captchaImg}}" mode="aspectFit" />
          <text wx:else class="captcha-placeholder">点击获取</text>
        </view>
      </view>
    </view>

    <button class="login-btn" bindtap="handleLogin" loading="{{loading}}">
      <text class="login-btn-text">登 录</text>
    </button>

    <view class="bottom-row">
      <view class="register-link" bindtap="handleRegister">
        <text>还没有账号？</text>
        <text class="link-highlight">立即注册</text>
      </view>
    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="footer-text">
    <text>Powered by NestJS + Vue + 微信小程序</text>
  </view>
</view>
