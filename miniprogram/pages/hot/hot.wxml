<view class="hot-page">
  <view class="hot-header">
    <text class="hot-header-title">🔥 抖音热搜榜</text>
    <text class="hot-header-refresh" bindtap="refreshList">刷新</text>
  </view>

  <view class="hot-list">
    <view class="hot-item" wx:for="{{hotList}}" wx:key="id">
      <view class="hot-rank {{index < 3 ? 'rank-top' : ''}}">{{index + 1}}</view>
      <view class="hot-info">
        <text class="hot-title">{{item.title}}</text>
        <text class="hot-value">热度 {{item.hotValue > 10000 ? (item.hotValue / 10000).toFixed(1) + '万' : item.hotValue}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !hotList.length}}">
    <text class="empty-icon">🔥</text>
    <text class="empty-text">暂无热榜数据</text>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
