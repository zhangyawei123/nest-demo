.hot-page {
  padding: 24rpx;
}

.hot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.hot-header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #303133;
}

.hot-header-refresh {
  font-size: 26rpx;
  color: #409eff;
  padding: 8rpx 24rpx;
  border: 2rpx solid #409eff;
  border-radius: 24rpx;
}

.hot-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #e4e7ed;
  color: #909399;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-top {
  background: linear-gradient(135deg, #f56c6c, #ff9a9e);
  color: #fff;
}

.hot-info {
  flex: 1;
  overflow: hidden;
}

.hot-title {
  font-size: 28rpx;
  color: #303133;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-bottom: 4rpx;
}

.hot-value {
  font-size: 22rpx;
  color: #909399;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #909399;
  font-size: 26rpx;
}
