.hot-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.52;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  top: 10rpx;
  right: -50rpx;
  background: radial-gradient(circle, rgba(255, 132, 132, 0.24) 0%, rgba(255, 132, 132, 0) 74%);
}

.orb-2 {
  width: 300rpx;
  height: 300rpx;
  top: 280rpx;
  left: -100rpx;
  background: radial-gradient(circle, rgba(255, 184, 77, 0.18) 0%, rgba(255, 184, 77, 0) 76%);
}

.hero-card {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(255, 111, 97, 0.98) 0%, rgba(255, 145, 77, 0.92) 54%, rgba(255, 198, 109, 0.84) 100%);
  box-shadow: 0 18rpx 44rpx rgba(255, 127, 80, 0.18);
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  right: -60rpx;
  top: -70rpx;
  background: rgba(255,255,255,0.14);
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255,255,255,0.72);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.88);
  position: relative;
  z-index: 1;
}

.hot-header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.hot-header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.hot-header-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b95a7;
}

.hot-header-refresh {
  font-size: 22rpx;
  color: #ff7f50;
  padding: 10rpx 22rpx;
  background: rgba(255, 127, 80, 0.12);
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.hot-list {
  position: relative;
  z-index: 1;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f8;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #edf2f8;
  color: #91a0b3;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-top {
  background: linear-gradient(135deg, #ff7d6b, #ffb36d);
  color: #fff;
}

.hot-info {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

.hot-title {
  font-size: 28rpx;
  color: #25324a;
  font-weight: 600;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-value {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #97a2b5;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #97a2b5;
  font-size: 26rpx;
}
