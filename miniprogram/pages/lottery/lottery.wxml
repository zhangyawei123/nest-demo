<view class="lottery-page">
  <!-- 转盘区域 -->
  <view class="wheel-area">
    <view class="wheel-container">
      <canvas type="2d" id="wheelCanvas" class="wheel-canvas" style="width:300px;height:300px;"></canvas>
      <view class="wheel-btn" bindtap="handleDraw">
        <text class="wheel-btn-text">抽奖</text>
      </view>
    </view>
  </view>

  <!-- 奖项列表 -->
  <view class="section card">
    <text class="section-title">🎁 奖项列表</text>
    <view class="prize-list">
      <view class="prize-item" wx:for="{{prizes}}" wx:key="id">
        <text class="prize-icon">{{item.icon}}</text>
        <view class="prize-info">
          <text class="prize-name">{{item.name}}</text>
          <text class="prize-desc">{{item.description}}</text>
        </view>
        <text class="prize-prob">{{item.probability}}%</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!prizes.length}}">
      <text class="empty-text">暂无奖项</text>
    </view>
  </view>

  <!-- 中奖弹窗 -->
  <view class="modal-mask" wx:if="{{showResult}}" bindtap="closeResult">
    <view class="modal-content" catchtap="">
      <text class="modal-icon">{{resultPrize.icon}}</text>
      <text class="modal-title">🎉 恭喜中奖！</text>
      <text class="modal-prize">{{resultPrize.name}}</text>
      <text class="modal-desc">{{resultPrize.description}}</text>
      <button class="btn-primary modal-btn" bindtap="closeResult">知道了</button>
    </view>
  </view>
</view>
