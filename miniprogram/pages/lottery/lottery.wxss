.lottery-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef4ff 0%, #f7f9fc 42%, #ffffff 100%);
  position: relative;
  overflow: visible;
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.5;
  pointer-events: none;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  top: 20rpx;
  right: -50rpx;
  background: radial-gradient(circle, rgba(115, 169, 255, 0.38) 0%, rgba(115, 169, 255, 0) 72%);
}

.orb-2 {
  width: 300rpx;
  height: 300rpx;
  top: 260rpx;
  left: -100rpx;
  background: radial-gradient(circle, rgba(245, 108, 108, 0.24) 0%, rgba(245, 108, 108, 0) 74%);
}

.hero-card {
  position: relative;
  z-index: 1;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(50, 120, 255, 0.96) 0%, rgba(85, 160, 255, 0.9) 55%, rgba(130, 205, 255, 0.84) 100%);
  box-shadow: 0 20rpx 48rpx rgba(64, 111, 215, 0.18);
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255,255,255,0.75);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 52rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #ffffff;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.85);
  max-width: 560rpx;
}

.hero-stats {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}

.hero-stat {
  flex: 1;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.14);
  backdrop-filter: blur(12rpx);
}

.hero-stat-accent {
  background: rgba(255,255,255,0.2);
}

.hero-stat-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

.hero-stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.wheel-panel,
.prize-card {
  position: relative;
  z-index: 1;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(21, 47, 89, 0.08);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-head-list {
  margin-bottom: 8rpx;
}

.panel-head-main {
  flex: 1;
}

.panel-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.panel-subtitle,
.section-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a94a6;
}

.panel-badge,
.list-count {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #4b7bff;
  font-size: 22rpx;
  font-weight: 600;
}

.panel-badge-active {
  background: rgba(245, 108, 108, 0.12);
  color: #f56c6c;
}

/* ========= 转盘区域 ========= */
.wheel-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 16rpx;
}

.pointer {
  width: 0;
  height: 0;
  border-left: 28rpx solid transparent;
  border-right: 28rpx solid transparent;
  border-top: 56rpx solid #f56c6c;
  position: relative;
  z-index: 10;
  margin-bottom: -18rpx;
  filter: drop-shadow(0 6rpx 8rpx rgba(245,108,108,0.28));
}

.wheel-container {
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  overflow: hidden;
  background: radial-gradient(circle at 50% 45%, #ffffff 0%, #f7f9fc 100%);
  box-shadow: 0 18rpx 40rpx rgba(33, 58, 117, 0.14);
  border: 12rpx solid #f7f8fc;
}

.wheel-canvas {
  width: 600rpx;
  height: 600rpx;
}

.wheel-tip {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8b95a7;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2d3d;
  display: block;
}

.prize-list {
  margin-top: 18rpx;
}

.prize-item {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  box-shadow: inset 0 0 0 1rpx #eef2f8;
  margin-bottom: 16rpx;
}

.prize-item:last-child {
  margin-bottom: 0;
}

.prize-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eef4ff, #f8fbff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: inset 0 0 0 1rpx rgba(75, 123, 255, 0.08);
}

.prize-icon {
  font-size: 40rpx;
}

.prize-info {
  flex: 1;
  min-width: 0;
}

.prize-name {
  font-size: 28rpx;
  color: #25324a;
  font-weight: 600;
  display: block;
}

.prize-desc {
  font-size: 22rpx;
  color: #8c96a8;
  margin-top: 8rpx;
  display: block;
  line-height: 1.5;
}

.prize-prob {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #e67e22;
  font-weight: 700;
  background: rgba(255, 177, 66, 0.12);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 36rpx;
  padding: 64rpx 48rpx 52rpx;
  width: 560rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.2);
}

.modal-icon-wrap {
  width: 132rpx;
  height: 132rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff3dd 0%, #ffe5ba 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 183, 77, 0.24);
}

.modal-icon {
  font-size: 96rpx;
}

.modal-kicker {
  display: block;
  margin-top: 22rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #9aa4b6;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f56c6c;
  margin-top: 14rpx;
}

.modal-prize {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2d3d;
  margin-top: 8rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #8c96a8;
  margin-top: 16rpx;
  margin-bottom: 36rpx;
  text-align: center;
  line-height: 1.6;
}

.modal-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}
