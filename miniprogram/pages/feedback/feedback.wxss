.feedback-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.feedback-hero {
  padding: 40rpx 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #25324a 0%, #4c8dff 100%);
  box-shadow: 0 18rpx 44rpx rgba(76, 141, 255, 0.2);
  margin-bottom: 24rpx;
}

.hero-title {
  display: block;
  font-size: 42rpx;
  color: #fff;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.86);
}

.form-card {
  padding-bottom: 12rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #25324a;
  margin-bottom: 16rpx;
}

.picker-value,
.contact-input,
.content-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f5f8ff;
  color: #25324a;
  font-size: 26rpx;
}

.picker-value {
  height: 84rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #a8b4c6;
  font-size: 32rpx;
}

.content-input {
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.contact-input {
  height: 84rpx;
  padding: 0 24rpx;
}

.input-count {
  display: block;
  text-align: right;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ba7b8;
}

.submit-btn {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: normal;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4c8dff 0%, #63b3ff 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(76, 141, 255, 0.22);
}

.submit-btn::after {
  border: none;
}
