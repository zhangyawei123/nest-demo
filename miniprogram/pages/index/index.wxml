<view class="index-page">
  <view class="bg-orb orb-1"></view>
  <view class="bg-orb orb-2"></view>

  <!-- 头部欢迎 -->
  <view class="hero-card">
    <view class="hero-top">
      <view class="header-info">
        <text class="greeting">{{greeting}}</text>
        <text class="username">{{userInfo.username || '未登录'}}</text>
      </view>
      <view class="header-avatar" bindtap="goLogin">
        <text class="avatar-text">{{userInfo.username ? userInfo.username[0] : '?'}}</text>
      </view>
    </view>
    <text class="hero-title">欢迎来到 NestDemo</text>
    <text class="hero-desc">聚合 AI 助手、热门内容和实用工具，让日常信息获取与轻量任务处理更高效。</text>
    <view class="login-guide" wx:if="{{!userInfo}}" bindtap="goLogin">
      <text class="login-guide-text">登录后解锁公告、AI 对话和更多个性化能力</text>
      <text class="login-guide-action">去登录</text>
    </view>
    <view class="hero-stats">
      <view class="hero-stat">
        <text class="hero-stat-label">公告</text>
        <text class="hero-stat-value">{{notices.length}}</text>
      </view>
      <view class="hero-stat">
        <text class="hero-stat-label">文章</text>
        <text class="hero-stat-value">{{articles.length}}</text>
      </view>
      <view class="hero-stat">
        <text class="hero-stat-label">热榜</text>
        <text class="hero-stat-value">{{hotList.length}}</text>
      </view>
    </view>
  </view>

  <view class="highlight-card card">
    <view class="highlight-item" wx:for="{{productHighlights}}" wx:key="title">
      <text class="highlight-icon">{{item.icon}}</text>
      <view class="highlight-main">
        <text class="highlight-title">{{item.title}}</text>
        <text class="highlight-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 公告横幅 -->
  <view class="notice-bar card" wx:if="{{notices.length}}" bindtap="goNotice">
    <view class="notice-icon-wrap">
      <text class="notice-icon">📢</text>
    </view>
    <view class="notice-main">
      <text class="notice-label">最新公告</text>
      <swiper class="notice-swiper" autoplay circular vertical>
        <swiper-item wx:for="{{notices}}" wx:key="id">
          <text class="notice-text">{{item.title}}</text>
        </swiper-item>
      </swiper>
    </view>
    <text class="notice-more">查看</text>
  </view>

  <!-- 功能入口 -->
  <view class="grid-nav card">
    <view class="section-header grid-head">
      <view>
        <text class="section-title">快捷入口</text>
        <text class="section-subtitle">常用能力一触即达</text>
      </view>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/articles/articles">
      <view class="grid-icon grid-blue">📄</view>
      <text class="grid-label">文章</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/hot/hot">
      <view class="grid-icon grid-red">🔥</view>
      <text class="grid-label">热榜</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/lottery/lottery">
      <view class="grid-icon grid-orange">🎯</view>
      <text class="grid-label">抽奖</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/ai-chat/ai-chat">
      <view class="grid-icon grid-green">🤖</view>
      <text class="grid-label">AI 对话</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/face-detect/face-detect">
      <view class="grid-icon grid-cyan">🧑</view>
      <text class="grid-label">人脸识别</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/recipe-combo/recipe-combo">
      <view class="grid-icon grid-orange">🍱</view>
      <text class="grid-label">菜谱套餐</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/notice/notice">
      <view class="grid-icon grid-cyan">📢</view>
      <text class="grid-label">公告</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/tools/tools">
      <view class="grid-icon grid-purple">🧰</view>
      <text class="grid-label">小工具</text>
    </view>
    <view class="grid-item" bindtap="goPage" data-url="/pages/mine/mine">
      <view class="grid-icon grid-purple">👤</view>
      <text class="grid-label">我的</text>
    </view>
  </view>

  <!-- 最新文章 -->
  <view class="section card">
    <view class="section-header">
      <view>
        <text class="section-title">最新文章</text>
        <text class="section-subtitle">看看最近更新了什么内容</text>
      </view>
      <text class="section-more" bindtap="goPage" data-url="/pages/articles/articles">更多</text>
    </view>
    <view class="loading-line" wx:if="{{loadingArticles}}">文章加载中...</view>
    <block wx:if="{{!loadingArticles}}">
      <view class="article-card" wx:for="{{articles}}" wx:key="id" bindtap="goArticle" data-id="{{item.id}}">
        <view class="article-dot"></view>
        <view class="article-content">
          <text class="article-title">{{item.title}}</text>
          <view class="article-meta">
            <text class="article-author">{{item.author.username}}</text>
            <text class="article-time">{{item.createdAtText}}</text>
          </view>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!loadingArticles && !articles.length}}">
      <text class="empty-icon">📄</text>
      <text class="empty-text">暂无文章，稍后再来看看</text>
    </view>
  </view>

  <!-- 热榜 -->
  <view class="section card">
    <view class="section-header">
      <view>
        <text class="section-title">🔥 抖音热榜</text>
        <text class="section-subtitle">实时了解当下热点话题</text>
      </view>
      <text class="section-more" bindtap="goPage" data-url="/pages/hot/hot">更多</text>
    </view>
    <view class="loading-line" wx:if="{{loadingHot}}">热榜加载中...</view>
    <block wx:if="{{!loadingHot}}">
      <view class="hot-item" wx:for="{{hotPreview}}" wx:key="id">
        <view class="hot-rank {{index < 3 ? 'hot-top' : ''}}">{{index + 1}}</view>
        <view class="hot-content">
          <text class="hot-title">{{item.title}}</text>
          <text class="hot-value">热度 {{item.hotValue}}</text>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!loadingHot && !hotList.length}}">
      <text class="empty-icon">🔥</text>
      <text class="empty-text">暂无热榜数据，请稍后刷新</text>
    </view>
  </view>
</view>
