.index-page {
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #409eff, #66b1ff);
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.greeting {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 8rpx;
  display: block;
}

.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.notice-bar {
  margin: 24rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.notice-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.notice-swiper {
  flex: 1;
  height: 40rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #e6a23c;
  line-height: 40rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grid-nav {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.grid-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.grid-label {
  font-size: 24rpx;
  color: #606266;
}

.section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #303133;
}

.section-more {
  font-size: 24rpx;
  color: #909399;
}

.article-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.article-card:last-child {
  border-bottom: none;
}

.article-title {
  font-size: 28rpx;
  color: #303133;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.article-meta {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #909399;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #e4e7ed;
  color: #909399;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.hot-top {
  background: #f56c6c;
  color: #fff;
}

.hot-title {
  flex: 1;
  font-size: 26rpx;
  color: #303133;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-value {
  font-size: 22rpx;
  color: #909399;
  margin-left: 12rpx;
  flex-shrink: 0;
}
