.index-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 44rpx;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  background: linear-gradient(180deg, #f2f6ff 0%, #f7f9fc 42%, #ffffff 100%);
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.55;
  pointer-events: none;
}

.orb-1 {
  width: 260rpx;
  height: 260rpx;
  top: 10rpx;
  right: -70rpx;
  background: radial-gradient(circle, rgba(103, 175, 255, 0.38) 0%, rgba(103, 175, 255, 0) 72%);
}

.orb-2 {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 280rpx;
  background: radial-gradient(circle, rgba(245, 108, 108, 0.22) 0%, rgba(245, 108, 108, 0) 76%);
}

.hero-card {
  position: relative;
  z-index: 1;
  border-radius: 34rpx;
  padding: 34rpx 30rpx;
  background: linear-gradient(135deg, rgba(58, 120, 255, 0.98) 0%, rgba(89, 156, 255, 0.92) 58%, rgba(132, 213, 255, 0.86) 100%);
  box-shadow: 0 20rpx 48rpx rgba(58, 120, 255, 0.2);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.hero-card::after {
  content: '';
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  right: -60rpx;
  top: -70rpx;
  background: rgba(255,255,255,0.12);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.header-info {
  flex: 1;
}

.greeting {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
}

.username {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.header-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.12);
}

.avatar-text {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 24rpx;
  font-size: 50rpx;
  line-height: 1.22;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  max-width: 560rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.88);
  position: relative;
  z-index: 1;
}

.login-guide {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.16);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  position: relative;
  z-index: 1;
}

.login-guide-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.88);
}

.login-guide-action {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.92);
  color: #4c8dff;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
  position: relative;
  z-index: 1;
}

.hero-stat {
  flex: 1;
  padding: 18rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.16);
}

.hero-stat-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.74);
}

.hero-stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.highlight-card {
  display: flex;
  gap: 14rpx;
  position: relative;
  z-index: 1;
}

.highlight-item {
  flex: 1;
  padding: 20rpx 14rpx;
  border-radius: 24rpx;
  background: #f6f9ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.highlight-icon {
  font-size: 38rpx;
  margin-bottom: 12rpx;
}

.highlight-main {
  min-width: 0;
}

.highlight-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #25324a;
}

.highlight-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #8b95a7;
}

.notice-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  position: relative;
  z-index: 1;
}

.notice-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff3de 0%, #fff8ed 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notice-icon {
  font-size: 34rpx;
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-label {
  display: block;
  font-size: 20rpx;
  color: #9ba4b5;
  margin-bottom: 8rpx;
}

.notice-swiper {
  height: 40rpx;
}

.notice-text {
  display: block;
  font-size: 26rpx;
  color: #25324a;
  line-height: 40rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice-more {
  font-size: 22rpx;
  color: #4c8dff;
  font-weight: 600;
}

.grid-nav {
  display: flex;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
}

.grid-head {
  width: 100%;
  margin-bottom: 8rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b95a7;
}

.section-more {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f5ff;
  color: #4c8dff;
  font-size: 22rpx;
  font-weight: 600;
}

.grid-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 10rpx;
}

.grid-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 14rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.4);
}

.grid-blue {
  background: linear-gradient(135deg, #edf4ff, #f7fbff);
}

.grid-red {
  background: linear-gradient(135deg, #fff0f0, #fff8f8);
}

.grid-orange {
  background: linear-gradient(135deg, #fff4e8, #fff9f2);
}

.grid-green {
  background: linear-gradient(135deg, #eefcf3, #f7fffa);
}

.grid-cyan {
  background: linear-gradient(135deg, #edf8ff, #f7fcff);
}

.grid-purple {
  background: linear-gradient(135deg, #f4efff, #faf7ff);
}

.grid-label {
  font-size: 24rpx;
  color: #4a5568;
  font-weight: 600;
}

.section {
  position: relative;
  z-index: 1;
}

.loading-line {
  padding: 32rpx 0;
  text-align: center;
  color: #8b95a7;
  font-size: 24rpx;
}

.article-card {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f8;
}

.article-card:last-child {
  border-bottom: none;
}

.article-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4c8dff, #63b3ff);
  margin-top: 12rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.article-content {
  flex: 1;
  min-width: 0;
}

.article-title {
  display: block;
  font-size: 28rpx;
  color: #25324a;
  font-weight: 600;
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.article-meta {
  display: flex;
  gap: 22rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #93a0b4;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f8;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #eef2f8;
  color: #91a0b3;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.hot-top {
  background: linear-gradient(135deg, #f56c6c, #ff8d8d);
  color: #fff;
}

.hot-content {
  flex: 1;
  min-width: 0;
}

.hot-title {
  display: block;
  font-size: 26rpx;
  color: #25324a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-value {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #97a2b5;
}
