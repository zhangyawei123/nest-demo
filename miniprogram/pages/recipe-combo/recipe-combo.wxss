.recipe-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.5;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  top: 10rpx;
  right: -70rpx;
  background: radial-gradient(circle, rgba(76, 141, 255, 0.28) 0%, rgba(76, 141, 255, 0) 72%);
}

.orb-2 {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 320rpx;
  background: radial-gradient(circle, rgba(110, 231, 183, 0.18) 0%, rgba(110, 231, 183, 0) 76%);
}

.recipe-hero {
  position: relative;
  z-index: 1;
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, rgba(255, 154, 68, 0.96) 0%, rgba(255, 107, 107, 0.90) 56%, rgba(255, 154, 162, 0.86) 100%);
  box-shadow: 0 18rpx 44rpx rgba(255, 107, 107, 0.18);
  overflow: hidden;
}

.recipe-hero::after {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  top: -70rpx;
  right: -60rpx;
  background: rgba(255,255,255,0.12);
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255,255,255,0.72);
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.88);
  position: relative;
  z-index: 1;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 24rpx;
  min-height: 380rpx;
  border: 3rpx dashed #c8d6e5;
  position: relative;
  z-index: 1;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #24324a;
}

.upload-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #97a2b5;
}

.preview-img {
  width: 100%;
  max-height: 520rpx;
  border-radius: 16rpx;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  margin: 0 24rpx 24rpx;
  position: relative;
  z-index: 1;
}

.btn-primary {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #dbe3ef;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary.active {
  background: linear-gradient(135deg, #ff9a44, #ff6b6b);
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 107, 0.2);
}

.btn-secondary {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #fff5f0;
  color: #ff6b6b;
  font-size: 30rpx;
  font-weight: 600;
}

.result-section {
  position: relative;
  z-index: 1;
}

.result-card {
  margin: 0 24rpx 20rpx;
}

.result-section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #24324a;
  margin-bottom: 16rpx;
}

.result-summary {
  display: block;
  font-size: 28rpx;
  line-height: 1.72;
  color: #4a5568;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #4c8dff;
  font-size: 24rpx;
  font-weight: 600;
}

.tag-green {
  background: #eefcf3;
  color: #2dcc70;
}

.combo-card {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #fff9f2 0%, #fff5ee 100%) !important;
}

.combo-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #24324a;
  margin-bottom: 20rpx;
}

.combo-items {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.combo-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.combo-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a44, #ff6b6b);
  flex-shrink: 0;
}

.combo-text {
  font-size: 28rpx;
  color: #24324a;
  font-weight: 500;
}

.combo-reason {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b95a7;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.05);
}

.tip-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  display: flex;
  gap: 12rpx;
}

.tip-dot {
  color: #ff9a44;
  font-size: 28rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a5568;
}
