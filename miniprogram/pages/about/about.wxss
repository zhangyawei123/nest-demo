.about-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.about-hero {
  padding: 48rpx 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #4c8dff 0%, #73c4ff 100%);
  box-shadow: 0 18rpx 44rpx rgba(76, 141, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 24rpx;
}

.app-logo {
  width: 116rpx;
  height: 116rpx;
  border-radius: 34rpx;
  background: rgba(255,255,255,0.22);
  color: #fff;
  font-size: 58rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 42rpx;
  color: #fff;
  font-weight: 800;
}

.app-version {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
}

.app-desc {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.9);
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b95a7;
}

.feature-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f8;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #4c8dff;
  margin-top: 12rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.feature-main {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #25324a;
}

.feature-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8b95a7;
}

.info-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2d3d;
  margin-bottom: 12rpx;
}

.info-text {
  display: block;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6b7688;
}

.contact-btn {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: normal;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4c8dff 0%, #63b3ff 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(76, 141, 255, 0.22);
}

.contact-btn::after {
  border: none;
}
