.detail-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  background: linear-gradient(180deg, #f2f6ff 0%, #f7f9fc 42%, #ffffff 100%);
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.5;
  pointer-events: none;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  top: 20rpx;
  right: -40rpx;
  background: radial-gradient(circle, rgba(103, 175, 255, 0.28) 0%, rgba(103, 175, 255, 0) 72%);
}

.orb-2 {
  width: 300rpx;
  height: 300rpx;
  left: -110rpx;
  top: 320rpx;
  background: radial-gradient(circle, rgba(245, 108, 108, 0.16) 0%, rgba(245, 108, 108, 0) 76%);
}

.detail-hero,
.detail-cover,
.detail-content {
  position: relative;
  z-index: 1;
}

.detail-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #8b95a7;
}

.detail-title {
  display: block;
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2d3d;
  line-height: 1.45;
}

.detail-meta {
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.meta-author,
.meta-time {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #6f7d92;
  background: #f4f7fb;
}

.cover-img {
  width: 100%;
  border-radius: 20rpx;
  display: block;
}

.detail-content {
  font-size: 30rpx;
  color: #334155;
  line-height: 1.9;
}

.detail-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.favorite-btn {
  margin: 0;
  height: 72rpx;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
  color: #4c8dff;
  border: 2rpx solid rgba(76, 141, 255, 0.22);
  font-size: 26rpx;
  font-weight: 700;
}

.favorite-btn.active {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(135deg, #ffb347, #ff7e5f);
}

.favorite-btn::after {
  border: none;
}
