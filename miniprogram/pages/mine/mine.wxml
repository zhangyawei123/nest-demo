<view class="mine-page">
  <!-- 用户信息头部 -->
  <view class="user-header" wx:if="{{userInfo}}">
    <view class="user-avatar">
      <text class="avatar-text">{{userInfo.username[0]}}</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.username}}</text>
      <text class="user-role">{{userInfo.roles && userInfo.roles.length ? userInfo.roles[0].name : '普通用户'}}</text>
    </view>
  </view>

  <view class="user-header guest" wx:else bindtap="goLogin">
    <view class="user-avatar guest-avatar">
      <text class="avatar-text">?</text>
    </view>
    <view class="user-info">
      <text class="user-name">未登录</text>
      <text class="user-role">点击登录</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-group card">
    <view class="menu-item" bindtap="goPage" data-url="/pages/lottery/lottery">
      <text class="menu-icon">🎯</text>
      <text class="menu-label">幸运转盘</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/ai-chat/ai-chat">
      <text class="menu-icon">🤖</text>
      <text class="menu-label">AI 对话</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/notice/notice">
      <text class="menu-icon">📢</text>
      <text class="menu-label">通知公告</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="menu-group card">
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-label">清除缓存</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-label">版本</text>
      <text class="menu-value">v1.0.0</text>
    </view>
  </view>

  <button class="logout-btn" wx:if="{{userInfo}}" bindtap="handleLogout">退出登录</button>
</view>
