<view class="mine-page">
  <view class="bg-orb orb-1"></view>
  <view class="bg-orb orb-2"></view>

  <!-- 用户信息头部 -->
  <view class="hero-card" wx:if="{{userInfo}}">
    <view class="hero-top">
      <view class="user-avatar">
        <text class="avatar-text">{{userInfo.username[0]}}</text>
      </view>
      <view class="hero-badge">已登录</view>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.username}}</text>
      <text class="user-role">{{userInfo.roles && userInfo.roles.length ? userInfo.roles[0].name : '普通用户'}}</text>
    </view>
    <text class="hero-desc">管理个人信息、常用功能入口与本地缓存设置。</text>
  </view>

  <view class="hero-card guest" wx:else bindtap="goLogin">
    <view class="hero-top">
      <view class="user-avatar guest-avatar">
        <text class="avatar-text">?</text>
      </view>
      <view class="hero-badge hero-badge-light">去登录</view>
    </view>
    <view class="user-info">
      <text class="user-name">未登录</text>
      <text class="user-role">点击登录</text>
    </view>
    <text class="hero-desc">登录后可同步账号状态、体验完整功能并保存个人数据。</text>
  </view>

  <!-- 功能列表 -->
  <view class="menu-group card">
    <view class="group-head">
      <text class="group-title">快捷功能</text>
      <text class="group-subtitle">常用服务与功能入口</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/lottery/lottery">
      <view class="menu-icon-wrap"><text class="menu-icon">🎯</text></view>
      <text class="menu-label">幸运转盘</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/ai-chat/ai-chat">
      <view class="menu-icon-wrap"><text class="menu-icon">🤖</text></view>
      <text class="menu-label">AI 对话</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/notice/notice">
      <view class="menu-icon-wrap"><text class="menu-icon">📢</text></view>
      <text class="menu-label">通知公告</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group card">
    <view class="group-head">
      <text class="group-title">系统设置</text>
      <text class="group-subtitle">缓存、版本与基础信息</text>
    </view>
    <view class="menu-item" bindtap="clearCache">
      <view class="menu-icon-wrap"><text class="menu-icon">🗑️</text></view>
      <text class="menu-label">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <view class="menu-icon-wrap"><text class="menu-icon">ℹ️</text></view>
      <text class="menu-label">版本</text>
      <text class="menu-value">v1.0.0</text>
    </view>
  </view>

  <button class="logout-btn" wx:if="{{userInfo}}" bindtap="handleLogout">退出登录</button>
</view>
