.mine-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.5;
}

.orb-1 {
  width: 240rpx;
  height: 240rpx;
  top: 20rpx;
  right: -50rpx;
  background: radial-gradient(circle, rgba(76, 141, 255, 0.32) 0%, rgba(76, 141, 255, 0) 72%);
}

.orb-2 {
  width: 320rpx;
  height: 320rpx;
  top: 320rpx;
  left: -120rpx;
  background: radial-gradient(circle, rgba(163, 110, 255, 0.18) 0%, rgba(163, 110, 255, 0) 76%);
}

.hero-card {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(70, 121, 255, 0.98) 0%, rgba(104, 153, 255, 0.92) 56%, rgba(170, 211, 255, 0.84) 100%);
  box-shadow: 0 18rpx 44rpx rgba(76, 141, 255, 0.18);
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  right: -60rpx;
  top: -70rpx;
  background: rgba(255,255,255,0.12);
}

.guest {
  background: linear-gradient(135deg, rgba(101, 116, 141, 0.98) 0%, rgba(132, 148, 170, 0.92) 55%, rgba(189, 199, 214, 0.82) 100%);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.12);
}

.guest-avatar {
  background: rgba(255,255,255,0.18);
}

.avatar-text {
  font-size: 46rpx;
  color: #fff;
  font-weight: 700;
}

.hero-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4c8dff;
  background: rgba(255,255,255,0.92);
}

.hero-badge-light {
  color: #5f6b7d;
}

.user-info {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255,255,255,0.82);
  margin-top: 8rpx;
  display: block;
}

.hero-desc {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.88);
}

.menu-group {
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.group-head {
  padding: 8rpx 4rpx 16rpx;
}

.group-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.group-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b95a7;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #eef2f8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #eef4ff, #f8fbff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  box-shadow: inset 0 0 0 1rpx rgba(76, 141, 255, 0.08);
}

.menu-icon {
  font-size: 34rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #25324a;
  font-weight: 600;
}

.menu-arrow {
  font-size: 28rpx;
  color: #b1bccd;
}

.menu-value {
  font-size: 24rpx;
  color: #8f9bad;
}

.logout-btn {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fff6f6 100%);
  color: #f56c6c;
  border: 2rpx solid rgba(245, 108, 108, 0.22);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
  box-shadow: 0 12rpx 24rpx rgba(245, 108, 108, 0.08);
}

.logout-btn::after {
  border: none;
}
